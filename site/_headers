# رؤوس الأمان — بتشتغل تلقائيًا على Netlify و Cloudflare Pages.
# (على Vercel انسخها إلى vercel.json، وعلى GitHub Pages مش مدعومة — الـ CSP الاحتياطي موجود في <meta>)

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/images/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/service-worker.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
