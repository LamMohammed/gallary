+body.dark-mode .sidebar{background:#081a33}
+body.dark-mode .topbar{background:#0d284a;border-bottom-color:rgba(226,194,90,.4)}
+body.dark-mode .nav-item.active{background:rgba(226,194,90,.14);color:#f0d57a;border-inline-start-color:#e2c25a}
+body.dark-mode input,body.dark-mode select,body.dark-mode textarea{background:rgba(244,239,225,.05);color:var(--ink);border-color:var(--line)}
