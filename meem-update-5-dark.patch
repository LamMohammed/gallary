+/* =====================================================================
+   الدارك للوحة الإدارة: نفس «العرض الليلي» — كحلي عميق وذهبي للأفعال الأساسية بس
+   ===================================================================== */
+body.dark-mode{--bg:#0b2140;--card:#123058;--line:#2a4a78;--ink:#f4efe1;--mute:#b9c5d8;--p:#e2c25a;--danger:#ff9c92}
